# Copy to .env.local and fill in. Only PUBLIC values belong here — never secret keys.

# Production URL, used for canonical links, og:url and the sitemap (no trailing slash).
VITE_SITE_URL=

# Optional public form endpoint (e.g. Formspree / Web3Forms / your own API) that accepts JSON POSTs.
# Leave empty to use the mail-app (mailto:) fallback.
VITE_CONTACT_ENDPOINT=
